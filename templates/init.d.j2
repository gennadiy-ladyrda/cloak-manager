#!/bin/sh /etc/rc.common

USE_PROCD=1

START=89
STOP=90

PROG=/usr/sbin/ck-client
CONFIG=/etc/cloak/{{ service_name }}.json

HOST=127.0.0.1
PORT={{ local_port }}

start_service() {
    procd_open_instance "{{ service_name }}"

    procd_set_param command "$PROG" \
        -s "$HOST" \
        -l "$PORT" \
        {% if transport == "udp" %}-u{% endif %} \
        -c "$CONFIG"

    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5

    procd_close_instance
}

reload_service() {
    stop
    sleep 2
    start
}
